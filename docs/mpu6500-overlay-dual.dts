/dts-v1/;
/plugin/;
/ {
	fragment@0 {
		target = <&spi3>;
		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			pinctrl-names = "default", "high_speed";
			pinctrl-0 = <&spi3_cs0 &spi3m1_pins>;
			pinctrl-1 = <&spi3_cs0 &spi3m1_pins_hs>;
			/* cs-gpios[0]=CS0 GPIO4_C6, cs-gpios[1]=CS1 GPIO1_B3, all active-low */
			cs-gpios = <&gpio4 0x16 0x01>, <&gpio1 0x0b 0x01>;
			mpu6500@0 {
				compatible = "invensense,mpu6500";
				reg = <0x00>;
				spi-max-frequency = <0xf4240>;
				interrupt-parent = <&gpio1>;
				interrupts = <0x0a 0x04>;          /* INT = GPIO1_B2 (pin10), level-high */
			};
			mpu6500@1 {
				compatible = "invensense,mpu6500";
				reg = <0x01>;
				spi-max-frequency = <0xf4240>;
				interrupt-parent = <&gpio2>;
				interrupts = <0x14 0x04>;          /* INT = GPIO2_C4 (pin20), level-high */
			};
		};
	};
};
