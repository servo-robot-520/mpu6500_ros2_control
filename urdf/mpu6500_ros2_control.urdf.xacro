<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    单个 MPU6500 传感器组件（生成一个 ros2_control <sensor> 硬件块）。

    一个组件对应一个 IIO 设备；插件不关心这颗 IMU 装在什么位置，由 name 与
    iio_device 决定。双 IMU 时请用下面的 mpu6500_imu_pair 宏，或在你的 URDF 中
    声明两个 mpu6500_sensor 实例（名字自定，例如 imu0 / imu1）。

    iio_device 默认使用 udev 稳定别名 /dev/mpu6500-0、/dev/mpu6500-1
    （见 udev/99-mpu6500-iio.rules）；未安装规则时可显式传 /dev/iio:deviceN。
  -->
  <xacro:macro name="mpu6500_sensor"
               params="name
                       iio_device:='/dev/mpu6500-0'
                       axis_map:='x,y,z'
                       expected_name:=''
                       verify_name:='true'
                       orientation_accel_gain:='0.05'
                       orientation_integral_gain:='0.0'
                       orientation_accel_tolerance:='0.25'
                       orientation_valid_samples:='25'
                       max_read_failures:='3'
                       log_level:='info'">
    <ros2_control name="${name}" type="sensor">
      <hardware>
        <plugin>mpu6500_ros2_control/MPU6500SensorInterface</plugin>
        <param name="iio_device">${iio_device}</param>
        <param name="axis_map">${axis_map}</param>
        <xacro:if value="${expected_name != ''}">
          <param name="expected_name">${expected_name}</param>
        </xacro:if>
        <param name="verify_name">${verify_name}</param>
        <param name="orientation.accel_gain">${orientation_accel_gain}</param>
        <param name="orientation.integral_gain">${orientation_integral_gain}</param>
        <param name="orientation.accel_tolerance">${orientation_accel_tolerance}</param>
        <param name="orientation.valid_samples">${orientation_valid_samples}</param>
        <param name="max_read_failures">${max_read_failures}</param>
        <param name="log.log_level">${log_level}</param>
        <param name="log.logger_name">mpu6500_ros2_control</param>
        <param name="log.node_name">mpu6500_ros2_control</param>
      </hardware>

      <sensor name="${name}">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <!-- 姿态已收敛且传感器健康时为 1；控制器应在 0 时保持 hold/home。 -->
        <state_interface name="orientation_valid"/>
      </sensor>
    </ros2_control>
  </xacro:macro>

  <!--
    两路 MPU6500（imu0 + imu1），带独立使能开关。

    默认同时启用两路；可用 enable_imu0 / enable_imu1 单独关闭。
    名字固定为 imu0 / imu1；若你的机器人要给这两个传感器其它连杆名，
    在机器人自身的 URDF 里建立对应 link 并在 imu_sensor_broadcaster 里设置
    相应的 frame_id 即可（详见 README），或直接调用 mpu6500_sensor 宏自定义名字。
  -->
  <xacro:macro name="mpu6500_imu_pair"
               params="enable_imu0:='true'
                       enable_imu1:='true'
                       imu0_iio_device:='/dev/mpu6500-0'
                       imu1_iio_device:='/dev/mpu6500-1'
                       imu0_axis_map:='x,y,z'
                       imu1_axis_map:='x,y,z'">
    <xacro:if value="${enable_imu0}">
      <xacro:mpu6500_sensor name="imu0"
                            iio_device="${imu0_iio_device}"
                            axis_map="${imu0_axis_map}"/>
    </xacro:if>
    <xacro:if value="${enable_imu1}">
      <xacro:mpu6500_sensor name="imu1"
                            iio_device="${imu1_iio_device}"
                            axis_map="${imu1_axis_map}"/>
    </xacro:if>
  </xacro:macro>
</robot>
